<Default
	title="Blog"
	description="From time to time, I write something: tutorials, technical writeups and the stories behind the software I built, mostly at VPSR."
	current="Blog"
>
	<h1 class="page-title">Blog</h1>
	<ol class="entries post-list" reversed>
		{posts.map((post) => (
			<li>
				<div class="entry-head">
					<h2 class="entry-title">
						<a href={post.href}>{post.title}</a>
					</h2>
					<time class="entry-date" datetime={post.date}>
						{post.date.slice(5, 7)}/{post.date.slice(0, 4)}
					</time>
				</div>
			</li>
		))}
	</ol>
</Default>
