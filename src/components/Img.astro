---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';
import { resolveImage } from '../lib/assets';

type Props = Omit<HTMLAttributes<'img'>, 'src' | 'srcset' | 'alt' | 'width' | 'height'> & {
	src: ImageMetadata | string;
	alt: string;
	widths?: number[];
};

const { src, alt, widths, ...attrs } = Astro.props;
const image = typeof src === 'string' ? resolveImage(src) : src;

let url = image.src;
let srcset: string | undefined;
let width = image.width;
let height = image.height;
if (image.format !== 'svg') {
	const candidates = widths?.filter((w) => w < image.width);
	if (candidates && candidates.length > 0) {
		const largest = Math.min(Math.max(...(widths ?? [])), image.width);
		const optimized = await getImage({ src: image, widths: [...new Set([...candidates, largest])], width: largest });
		url = optimized.src;
		srcset = optimized.srcSet.attribute;
		width = largest;
		height = Math.round((image.height / image.width) * largest);
	} else {
		url = (await getImage({ src: image })).src;
	}
}
---

<img src={url} srcset={srcset} width={width} height={height} alt={alt} {...attrs} />
